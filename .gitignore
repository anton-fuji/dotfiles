# Ignore everything by default. This keeps generated state, caches, and secrets
# out of the dotfiles repo unless they are explicitly allowlisted below.
*

!.gitignore
!README.md
!justfile
!flake.nix
!flake.lock
!starship.toml
!cz.config.cjs
!scripts/
!scripts/**

!img/
!img/**

!btop/
!btop/btop.conf
!btop/themes/
!btop/themes/kyli0x.theme

!eza/
!eza/theme.yml

!fastfetch/
!fastfetch/**

!fish/
!fish/**

!gh-dash/
!gh-dash/config.yml

!herdr-app/
!herdr-app/keys.json
!herdr-app/settings.json
!herdr-app/layouts/
!herdr-app/layouts/my-main.json
!herdr-app/backgrounds/
!herdr-app/backgrounds/**
!herdr-app/mods/
!herdr-app/mods/zj-*/
!herdr-app/mods/zj-*/main.js
!herdr-app/mods/zj-*/mod.json
!herdr-app/mods/zj-*/mode.js
!herdr-app/mods/jump-attention/
!herdr-app/mods/jump-attention/main.js
!herdr-app/mods/jump-attention/mod.json
!herdr-app/mods/my-changes/
!herdr-app/mods/my-changes/main.js
!herdr-app/mods/my-changes/mod.json
!herdr-app/mods/my-changes/changes.svg

!htop/
!htop/htoprc

!hunk/
!hunk/config.toml

!lazygit/
!lazygit/config.yml

!nix/
!nix/**

!nvim/
!nvim/**

!wezterm/
!wezterm/**

!yazi/
!yazi/**

!zed/
!zed/settings.json
!zed/keymap.json

!zellij/
!zellij/config.kdl
!zellij/layouts/
!zellij/layouts/**

.DS_Store
**/.DS_Store
*.bak
*.log
result

# Local ASCII Motion export artifacts
**/.ascii-motion/

# Optional local build of the Gopher authoring tool
fastfetch/gopher/gopher-art
fastfetch/gopher/gopher-art.exe
